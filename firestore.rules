rules_version = '2';

// ─── Luật phân quyền Firestore — Gia sư Hóa 11 ───────────────────────────────
//
// Luật ĐANG CHẠY trước bản này (đọc trong bảng điều khiển ngày 10/09/2026, bản
// ghi ngày 22/07/2026) chỉ có đúng một dòng có tác dụng:
//
//     match /{document=**} { allow read, write: if true; }
//
// Tức toàn bộ cơ sở dữ liệu mở toang: ai trên Internet cũng đọc, sửa, xoá được
// mọi thứ. Chính Firebase cũng dán cảnh báo đỏ lên đó.
//
// ─── VÌ SAO LUẬT NÀY KHÔNG KIỂM DANH TÍNH ──────────────────────────────────
//
// Dự án dùng hệ đăng nhập TỰ VIẾT (`src/core/services/firestoreAuth.ts`), KHÔNG
// dùng Firebase Auth. Nghĩa là `request.auth` LUÔN LUÔN null ở mọi yêu cầu.
// Không có cách nào để luật biết ai đang gọi.
//
// Hệ quả phải nói thẳng: luật ở đây KHÔNG thể phân quyền theo vai trò. Nó chỉ
// làm được một việc — kiểm HÌNH DẠNG dữ liệu. Muốn phân quyền thật thì phải
// chuyển sang Firebase Auth, và đó là một việc riêng cần bàn với chủ dự án.
//
// ─── HAI LỖ HỔNG ĐÃ BIẾT, CHƯA VÁ ĐƯỢC Ở ĐÂY ───────────────────────────────
//
// (a) `users` chứa mật khẩu dạng CHỮ THƯỜNG và phải cho đọc, vì việc đăng nhập
//     chạy ngay trên trình duyệt: nó tải bản ghi người dùng về rồi so mật khẩu.
//     Tức bất kỳ ai cũng đọc được toàn bộ mật khẩu. Không luật nào cứu được
//     điều này — chỉ Firebase Auth mới cứu được.
//
// (b) Mọi collection đều phải cho ghi, vì không có danh tính để phân biệt giáo
//     viên với người lạ.
//
// Thứ luật này LÀM ĐƯỢC, và làm ngay: chặn nội dung có mã ở `bank_questions`.
// Đó là đường tấn công đã được xác minh ngày 10/09/2026 — kẻ tấn công ghi một
// câu hỏi chứa `<img src=x onerror=…>`, và nó chạy trong trình duyệt của mọi
// học sinh mở đề. Phía trình duyệt đã vá bằng `src/core/services/locHtml.ts`;
// luật dưới đây là hàng rào thứ hai, chặn ngay từ lúc GHI.
//
// ─── BẢN ĐẦU CỦA TỆP NÀY NHẮM SAI TÊN TRƯỜNG ───────────────────────────────
//
// Ghi lại vì đây đúng là kiểu lỗi làm một hàng rào trông như đang đứng mà thật
// ra không chắn gì. Bản viết sáng 10/09/2026 kiểm `content` / `explanation` /
// `options` — tên lấy từ trí nhớ, không ai đo. Firestore thật lưu `q` / `e` /
// `o`. Mệnh đề `!('content' in d) || …` vì thế LUÔN đúng, và luật cho qua mọi
// tải trọng miễn là đặt vào trường `q`. Nó sẽ ĐẠT mọi phép thử kiểu "câu hỏi
// sạch vẫn ghi được" mà không chặn nổi một đòn tấn công nào.
//
// Tên trường dưới đây đọc thẳng từ 60 bản ghi thật trong Firestore ngày
// 10/09/2026, đối chiếu với `src/features/bank/types.ts`.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Trợ giúp ────────────────────────────────────────────────────────────

    // Một chuỗi có an toàn để đổ vào `dangerouslySetInnerHTML` không?
    //
    // Danh sách CẤM ở đây là cố ý và có giới hạn: nó KHÔNG thay thế bộ lọc phía
    // trình duyệt (bộ lọc đó dùng danh sách CHO PHÉP, chặt hơn hẳn). Luật
    // Firestore không có bộ phân tích HTML, nên chỗ này chỉ chặn những dạng thô
    // nhất — đủ để một kẻ tấn công tiện tay bị chặn ngay từ cửa.
    //
    // Cờ `(?is)` chứ không phải `(?i)`: trong RE2, dấu chấm KHÔNG khớp ký tự
    // xuống dòng. Thiếu chữ `s` thì chỉ cần chèn một dấu xuống dòng trước tải
    // trọng là lách được cả bốn mẫu dưới đây.
    //
    // KHÔNG cấm dấu `<` và `>` nói chung: nội dung hoá học dùng chúng làm dấu
    // so sánh thật ("pH < 7 là môi trường acid"). Đã đếm trên 252 câu đang có.
    function sach(s) {
      return s is string
        && s.size() < 4000
        && !s.matches('(?is).*<\\s*/?\\s*(script|iframe|object|embed|link|meta|base|svg|img|video|audio|form|input|style|template|marquee)[\\s/>].*')
        && !s.matches('(?is).*\\son[a-z]+\\s*=.*')
        && !s.matches('(?is).*javascript\\s*:.*')
        && !s.matches('(?is).*data\\s*:\\s*text/html.*');
    }

    // Bốn phương án trắc nghiệm. Luật Firestore không có vòng lặp, nên phải mở
    // từng chỉ số. `types.ts` khai "Đúng 4 phương án", và 252 câu đang có đều là
    // 0 hoặc đúng 4 — nên chặn ở 4. Ngày nào cần 5 phương án thì luật này từ
    // chối và người sửa sẽ biết ngay tại sao; im lặng hỏng còn hơn im lặng mở.
    function phuongAnSach(d) {
      return !('o' in d) || (
        d.o.size() <= 4
        && (d.o.size() < 1 || sach(d.o[0]))
        && (d.o.size() < 2 || sach(d.o[1]))
        && (d.o.size() < 3 || sach(d.o[2]))
        && (d.o.size() < 4 || sach(d.o[3]))
      );
    }

    // Bốn ý của câu đúng/sai. Mỗi ý là một map { s: nội dung, v: đúng hay sai }.
    function ySach(d) {
      return !('st' in d) || (
        d.st.size() <= 4
        && (d.st.size() < 1 || sach(d.st[0].s))
        && (d.st.size() < 2 || sach(d.st[1].s))
        && (d.st.size() < 3 || sach(d.st[2].s))
        && (d.st.size() < 4 || sach(d.st[3].s))
      );
    }

    // Một câu hỏi hợp lệ. Mọi trường CHỮ đi tới `ChemicalText` đều phải sạch:
    // `q`, `e`, từng phương án `o[]`, từng ý `st[].s`, và `ansText`.
    //
    // `img` cố ý KHÔNG bị quét bằng `sach()`: nó là ảnh dạng data URI (đo được
    // tới 66.000 ký tự) và đi vào thuộc tính src của thẻ <img>, không đi vào
    // innerHTML. Ràng buộc của nó là phải bắt đầu bằng `data:image/`.
    //
    // Ngưỡng đều rộng gấp nhiều lần số đo thật ngày 10/09/2026: nhiều nhất 14
    // trường một câu, `q` dài nhất 333 ký tự, `e` dài nhất 316, mỗi phương án
    // dài nhất 80, mỗi ý dài nhất 113.
    function cauHoiSach() {
      let d = request.resource.data;
      return request.resource.size() < 40
        && 'q' in d && sach(d.q)
        && (!('e' in d) || sach(d.e))
        && (!('ansText' in d) || sach(d.ansText))
        && phuongAnSach(d)
        && ySach(d)
        && (!('img' in d) || (d.img is string && d.img.matches('(?s)data:image/.*')));
    }

    // ── Ngân hàng câu hỏi ───────────────────────────────────────────────────
    // Đọc: công khai. Trò chơi và bộ kiểm đọc thẳng, không đăng nhập.
    // Ghi:  vẫn mở (chưa có danh tính), NHƯNG nội dung phải sạch.
    match /bank_questions/{id} {
      allow read: if true;
      allow create, update: if cauHoiSach();
      allow delete: if true;
    }

    // Kho câu hỏi cũ. Đọc thật ngày 10/09/2026: RỖNG, không còn bản ghi nào.
    // Giữ luật giống hệt, để nếu có ai ghi lại vào đây thì cũng phải sạch.
    match /questions/{id} {
      allow read: if true;
      allow create, update: if cauHoiSach();
      allow delete: if true;
    }

    // ── Các collection còn lại ──────────────────────────────────────────────
    // Giữ nguyên quyền như luật cũ. Siết chúng lại đòi có danh tính, tức đòi
    // Firebase Auth — việc riêng, phải bàn trước.
    //
    // CẢNH BÁO cho `users`: bản ghi ở đây chứa mật khẩu dạng chữ thường và ai
    // cũng đọc được. Đây là lỗ hổng nặng nhất của dự án.
    match /users/{id}          { allow read, write: if true; }
    match /chats/{id}          { allow read, write: if true; }
    match /classes/{id}        { allow read, write: if true; }
    match /schools/{id}        { allow read, write: if true; }
    match /exams/{id}          { allow read, write: if true; }
    match /progress/{id}       { allow read, write: if true; }
    match /equations/{id}      { allow read, write: if true; }
    match /matrix_resources/{id}    { allow read, write: if true; }
    match /curriculum_chapters/{id} { allow read, write: if true; }
    match /system_settings/{id}     { allow read, write: if true; }

    // ── Mọi thứ khác: cấm ───────────────────────────────────────────────────
    // Mười hai collection trên là toàn bộ những gì mã nguồn dùng tới, liệt kê
    // bằng cách quét `collection(db, …)` và các hằng `COL_*` ngày 10/09/2026.
    // Đã kiểm thêm: dự án KHÔNG dùng subcollection nào, nên các mục `match` một
    // tầng ở trên phủ hết. Thêm collection mới thì phải thêm luật cho nó ở đây.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
