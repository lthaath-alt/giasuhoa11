rules_version = '2';

// ─── Luật phân quyền Firestore — Gia sư Hóa 11 ───────────────────────────────
//
// Luật ĐANG CHẠY trước bản này (đọc trong bảng điều khiển ngày 10/09/2026, bản
// ghi ngày 22/07/2026) chỉ có đúng một dòng có tác dụng:
//
//     match /{document=**} { allow read, write: if true; }
//
// Tức toàn bộ cơ sở dữ liệu mở toang: ai trên Internet cũng đọc, sửa, xoá được
// mọi thứ. Chính Firebase cũng dán cảnh báo đỏ lên đó.
//
// ─── HIỆN TRẠNG DANH TÍNH (từ đợt chuyển 10/09/2026) ───────────────────────
//
// Dự án dùng Firebase Auth (email + mật khẩu) — KHÔNG còn là hệ tự viết so
// mật khẩu trên trình duyệt. `request.auth` mang uid và email thật của người
// gọi đã đăng nhập; id tài liệu `users` BẰNG uid đó, nên luật đọc được vai
// bằng `get(/databases/$(database)/documents/users/$(request.auth.uid))`.
// Mật khẩu không còn nằm trong Firestore — Firebase Auth giữ nó ở dạng đã băm
// và không bao giờ trả về trình duyệt.
//
// Phân quyền theo vai (`laGiaoVien()`, `laQuanTri()` bên dưới, và luật riêng
// từng trường ở `match /users/{userId}`) ĐÃ CÓ từ đợt 2 — không còn là việc
// "cần bàn riêng".
//
// Thứ luật này LÀM ĐƯỢC, và làm ngay: chặn nội dung có mã ở `bank_questions`.
// Đó là đường tấn công đã được xác minh ngày 10/09/2026 — kẻ tấn công ghi một
// câu hỏi chứa `<img src=x onerror=…>`, và nó chạy trong trình duyệt của mọi
// học sinh mở đề. Phía trình duyệt đã vá bằng `src/core/services/locHtml.ts`;
// luật dưới đây là hàng rào thứ hai, chặn ngay từ lúc GHI.
//
// ─── BẢN ĐẦU CỦA TỆP NÀY NHẮM SAI TÊN TRƯỜNG ───────────────────────────────
//
// Ghi lại vì đây đúng là kiểu lỗi làm một hàng rào trông như đang đứng mà thật
// ra không chắn gì. Bản viết sáng 10/09/2026 kiểm `content` / `explanation` /
// `options` — tên lấy từ trí nhớ, không ai đo. Firestore thật lưu `q` / `e` /
// `o`. Mệnh đề `!('content' in d) || …` vì thế LUÔN đúng, và luật cho qua mọi
// tải trọng miễn là đặt vào trường `q`. Nó sẽ ĐẠT mọi phép thử kiểu "câu hỏi
// sạch vẫn ghi được" mà không chặn nổi một đòn tấn công nào.
//
// Tên trường dưới đây đọc thẳng từ 60 bản ghi thật trong Firestore ngày
// 10/09/2026, đối chiếu với `src/features/bank/types.ts`.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Danh tính và vai trò (đợt 2, 10/09/2026) ────────────────────────────

    function dangNhap() {
      return request.auth != null;
    }

    /* Email nằm sẵn trong token, đọc nó KHÔNG tốn lượt đọc nào. Đây là lý do
       mọi phép kiểm quyền sở hữu bên dưới đều dùng email chứ không dùng uid. */
    function email() {
      return request.auth.token.email;
    }

    /* NGƯỢC LẠI: mỗi lần gọi get() là MỘT LƯỢT ĐỌC CÓ TÍNH TIỀN. Gói Spark cho
       50.000 lượt/ngày. Vì thế hàm này chỉ được dùng ở những đường ghi HIẾM
       (giáo viên soạn câu hỏi, quản trị sửa cấu hình), và TUYỆT ĐỐI KHÔNG dùng
       trong luật của `progress` và `chats` — hai chỗ học sinh ghi liên tục
       trong lúc học.
       Cách đúng đắn hơn là custom claims, nhưng thứ đó cần Admin SDK trong
       Cloud Function, tức gói Blaze trả tiền. */
    function vaiTro() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function laGiaoVien() {
      return dangNhap() && vaiTro() in ['teacher', 'school_admin', 'admin'];
    }

    function laQuanTri() {
      return dangNhap() && vaiTro() in ['school_admin', 'admin'];
    }

    /* CHỦ DỰ ÁN — đúng MỘT người, ghim bằng email 13/09/2026.

       Vì sao không dùng vai trong hồ sơ: vai chính là thứ hàng rào này bảo
       vệ. Ai sửa được `role` thì tự phong được, nên lấy `role` ra canh
       `role` là khoá tự mở cho chính nó — đúng lỗ hổng `laQuanTri()` để
       ngỏ trước bản này: một `school_admin` tự nâng mình lên `admin`.

       Email đến từ token Firebase Auth ĐÃ XÁC THỰC nên không giả được, và
       đọc token KHÔNG tốn lượt đọc nào — rẻ hơn hẳn `laQuanTri()` vốn phải
       get() hồ sơ. Vì thế mệnh đề này đặt TRƯỚC trong mọi phép `||` bên
       dưới: chủ dự án thao tác thì không tốn lượt đọc nào cả.

       ĐỔI EMAIL LÀ PHẢI PUBLISH LẠI LUẬT. Ghim sai email thì không ai đặt
       được vai nữa, và đường chữa duy nhất là bảng điều khiển Firebase. */
    function laChuDuAn() {
      return dangNhap() && email() == 'ktranquang713@gmail.com';
    }

    /* ĐỒNG QUẢN TRỊ — chủ dự án chỉ định, danh sách nằm ở một tài liệu duy
       nhất mà chỉ chủ dự án ghi được.

       Vì sao KHÔNG cắm cờ `coAdmin: true` lên hồ sơ từng người: rẻ hơn thật
       (luật vốn đã đọc hồ sơ người gọi để lấy `role`), nhưng nó mở HAI cửa
       phải canh — học sinh tự sửa hồ sơ mình, và người mới tự đăng ký. Quên
       một cửa là ai cũng tự phong. Dự án này đã vấp đúng kiểu lỗi đó hai lần.

       Vì sao KHÔNG để trong `system_settings`: chỗ đó đang `allow write: if
       laQuanTri()`, tức một `school_admin` ghi được và sẽ tự thêm mình.

       Hàm này TỐN MỘT LƯỢT ĐỌC. Vì thế mọi phép `||` bên dưới đặt nó ở CUỐI,
       sau các nhánh không tốn gì. */
    function laDongQuanTri() {
      return dangNhap() && get(/databases/$(database)/documents/quan_tri/dong_quan_tri)
               .data.emails.hasAny([email()]);
    }

    // ── Trợ giúp: kiểm nội dung câu hỏi ─────────────────────────────────────

    // Một chuỗi có an toàn để đổ vào `dangerouslySetInnerHTML` không?
    //
    // Danh sách CẤM ở đây là cố ý và có giới hạn: nó KHÔNG thay thế bộ lọc phía
    // trình duyệt (bộ lọc đó dùng danh sách CHO PHÉP, chặt hơn hẳn). Luật
    // Firestore không có bộ phân tích HTML, nên chỗ này chỉ chặn những dạng thô
    // nhất — đủ để một kẻ tấn công tiện tay bị chặn ngay từ cửa.
    //
    // Cờ `(?is)` chứ không phải `(?i)`: trong RE2, dấu chấm KHÔNG khớp ký tự
    // xuống dòng. Thiếu chữ `s` thì chỉ cần chèn một dấu xuống dòng trước tải
    // trọng là lách được cả bốn mẫu dưới đây.
    //
    // KHÔNG cấm dấu `<` và `>` nói chung: nội dung hoá học dùng chúng làm dấu
    // so sánh thật ("pH < 7 là môi trường acid"). Đã đếm trên 252 câu đang có.
    function sach(s) {
      return s is string
        && s.size() < 4000
        && !s.matches('(?is).*<\\s*/?\\s*(script|iframe|object|embed|link|meta|base|svg|img|video|audio|form|input|style|template|marquee)[\\s/>].*')
        && !s.matches('(?is).*\\son[a-z]+\\s*=.*')
        && !s.matches('(?is).*javascript\\s*:.*')
        && !s.matches('(?is).*data\\s*:\\s*text/html.*');
    }

    // Bốn phương án trắc nghiệm. Luật Firestore không có vòng lặp, nên phải mở
    // từng chỉ số. `types.ts` khai "Đúng 4 phương án", và 252 câu đang có đều là
    // 0 hoặc đúng 4 — nên chặn ở 4. Ngày nào cần 5 phương án thì luật này từ
    // chối và người sửa sẽ biết ngay tại sao; im lặng hỏng còn hơn im lặng mở.
    function phuongAnSach(d) {
      return !('o' in d) || (
        d.o.size() <= 4
        && (d.o.size() < 1 || sach(d.o[0]))
        && (d.o.size() < 2 || sach(d.o[1]))
        && (d.o.size() < 3 || sach(d.o[2]))
        && (d.o.size() < 4 || sach(d.o[3]))
      );
    }

    // Bốn ý của câu đúng/sai. Mỗi ý là một map { s: nội dung, v: đúng hay sai }.
    function ySach(d) {
      return !('st' in d) || (
        d.st.size() <= 4
        && (d.st.size() < 1 || sach(d.st[0].s))
        && (d.st.size() < 2 || sach(d.st[1].s))
        && (d.st.size() < 3 || sach(d.st[2].s))
        && (d.st.size() < 4 || sach(d.st[3].s))
      );
    }

    // Một câu hỏi hợp lệ. Mọi trường CHỮ đi tới `ChemicalText` đều phải sạch:
    // `q`, `e`, từng phương án `o[]`, từng ý `st[].s`, và `ansText`.
    //
    // `img` cố ý KHÔNG bị quét bằng `sach()`: nó là ảnh dạng data URI (đo được
    // tới 66.000 ký tự) và đi vào thuộc tính src của thẻ <img>, không đi vào
    // innerHTML. Ràng buộc của nó là phải bắt đầu bằng `data:image/`.
    //
    // Ngưỡng đều rộng gấp nhiều lần số đo thật ngày 10/09/2026: nhiều nhất 14
    // trường một câu, `q` dài nhất 333 ký tự, `e` dài nhất 316, mỗi phương án
    // dài nhất 80, mỗi ý dài nhất 113.
    function cauHoiSach() {
      let d = request.resource.data;
      return request.resource.size() < 40
        && 'q' in d && sach(d.q)
        && (!('e' in d) || sach(d.e))
        && (!('ansText' in d) || sach(d.ansText))
        && phuongAnSach(d)
        && ySach(d)
        && (!('img' in d) || (d.img is string && d.img.matches('(?s)data:image/.*')));
    }

    // ── Ngân hàng câu hỏi ───────────────────────────────────────────────────
    /* ĐỌC PHẢI GIỮ CÔNG KHAI. Workflow đồng bộ đêm
       (.github/workflows/dong-bo-ngan-hang.yml → npm run xuat:ngan-hang) đọc
       Firestore KHÔNG đăng nhập, chỉ bằng khoá web. Siết dòng này là đồng bộ
       chết mà không ai biết — web vẫn đúng vì nó đọc thẳng Firestore, chỉ có
       bản chụp trong git lệch dần. */
    match /bank_questions/{id} {
      allow read: if true;
      allow create, update: if laGiaoVien() && cauHoiSach();
      allow delete: if laGiaoVien();
    }

    // Kho câu hỏi cũ. Đọc thật ngày 10/09/2026: RỖNG, không còn bản ghi nào.
    // Giữ luật giống hệt, để nếu có ai ghi lại vào đây thì cũng phải sạch.
    match /questions/{id} {
      allow read: if true;
      allow create, update: if laGiaoVien() && cauHoiSach();
      allow delete: if laGiaoVien();
    }

    // ── Nội dung học: đọc công khai, ghi theo vai ───────────────────────────
    // Trang chào và chế độ "Dùng Thử" đọc những thứ này khi chưa đăng nhập.
    match /curriculum_chapters/{id} { allow read: if true; allow write: if laGiaoVien(); }
    match /exams/{id}               { allow read: if true; allow write: if laGiaoVien(); }
    match /equations/{id}           { allow read: if true; allow write: if laGiaoVien(); }
    match /matrix_resources/{id}    { allow read: if true; allow write: if laGiaoVien(); }
    match /system_settings/{id}     { allow read: if true; allow write: if laQuanTri(); }
    match /schools/{id}             { allow read: if true; allow write: if laQuanTri(); }

    // ── Dữ liệu người: phải đăng nhập ───────────────────────────────────────

    /* Id tài liệu CHÍNH LÀ email — đã kiểm trên dữ liệu thật ngày 10/09/2026.
       Nhờ vậy kiểm được quyền sở hữu mà KHÔNG tốn lượt đọc nào. Đây là chỗ học
       sinh ghi nhiều nhất nên không được phép dùng get(). */
    match /progress/{userId} {
      allow read, write: if dangNhap() && (email() == userId || laGiaoVien());
    }

    /* Bài kiểm tra ĐÃ NỘP (18/09/2026). Trước đó bài chỉ nằm trong
       localStorage của máy học sinh, còn trang giáo viên đọc localStorage của
       máy GIÁO VIÊN — nên giáo viên không bao giờ thấy bài nào, và điểm tự
       luận chấm lại không bao giờ về tới học sinh.

       Học sinh TẠO bài của chính mình: chỉ so email trong token, KHÔNG get().
       Học sinh không sửa được bài đã nộp; giáo viên chỉ sửa `score` và
       `results` (chấm lại tự luận). Không ai xoá.

       GIỚI HẠN ĐÃ BIẾT: điểm do trình duyệt chấm. Luật chặn được điểm vượt
       tối đa và bài đứng tên người khác, KHÔNG chặn được một học sinh tự dựng
       bài điểm cao. Chặn thật phải chấm lại ở máy chủ (Cloud Function, gói
       Blaze trả tiền). */
    function baiNopHopLe(d, id) {
      return d.keys().hasOnly(['id', 'lessonId', 'chapterId', 'userEmail', 'questions',
                               'answers', 'status', 'score', 'maxScore', 'createdAt',
                               'expiresAt', 'results'])
        && d.id == id
        && d.status == 'submitted'
        && d.score is number && d.maxScore is number
        && d.score >= 0 && d.score <= d.maxScore;
    }
    match /bai_nop/{id} {
      allow get:    if dangNhap() && (resource.data.userEmail == email() || laGiaoVien());
      allow list:   if laGiaoVien();
      allow create: if dangNhap() && request.resource.data.userEmail == email()
        && baiNopHopLe(request.resource.data, id);
      allow update: if laGiaoVien()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score', 'results'])
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= resource.data.maxScore;
      allow delete: if false;
    }

    /* App đọc chats bằng query(where('userEmail','==',…), where('lessonId','==',…)),
       tức truy vấn CÓ RÀNG BUỘC trên đúng trường luật kiểm — điều kiện bắt buộc
       để Firestore cho phép một truy vấn. Xem `getChatsByUserLesson` trong
       firestoreService.ts. */
    match /chats/{id} {
      allow read:   if dangNhap() && (email() == resource.data.userEmail || laGiaoVien());
      allow create: if dangNhap() && email() == request.resource.data.userEmail;
      allow update, delete: if dangNhap() && (email() == resource.data.userEmail || laGiaoVien());
    }

    /* Đọc rộng cho người đã đăng nhập, CÓ CHỦ Ý. Học sinh tự đăng ký vào lớp
       bằng mã mời (`joinClassByCode` tra `classes.find(c => c.inviteCode …)`),
       mà lúc đó email các em CHƯA nằm trong studentIdentifiers. Siết chặt hơn
       là chức năng "vào lớp bằng mã" chết.
       Hệ quả đã biết và chấp nhận: học sinh đã đăng nhập thấy được email bạn
       cùng trường. Muốn kín hơn thì tách mã mời ra một collection riêng. */
    match /classes/{id} {
      allow read:  if dangNhap();
      allow write: if laGiaoVien();
    }

    /* Danh sách đồng quản trị. Một tài liệu: `dong_quan_tri`.

       PHẢI cho đồng quản trị ĐỌC. Bản thiết kế đầu để mỗi `laChuDuAn()` cho
       kín, nhưng thế thì chính người đồng quản trị không đọc được danh sách để
       biết mình có quyền — giao diện sẽ không vẽ nút Duyệt cho họ, và lỗi chỉ
       lộ ra lúc thử tay.

       Không có vòng lặp: `get()` trong luật KHÔNG bị luật đọc chặn. */
    match /quan_tri/{id} {
      allow read:  if laChuDuAn() || laDongQuanTri();
      allow write: if laChuDuAn();
    }

    /* SÁU điều phải nhớ, cả sáu đều đã viết sai một lần:

       1. `create` phải cho phép giáo viên tạo hộ — nhưng chỉ tạo hộ HỌC SINH.
          Tạo tài khoản giáo viên khác hay admin trường là việc của quản trị,
          đi qua `laQuanTri()`; nhánh giáo viên ở đây chỉ mở khi
          `role == 'student'`. Khi admin tạo tài khoản cho giáo viên, bản ghi
          Auth tạo trên app PHỤ (xem `taoAuthPhu()`) nhưng hồ sơ ghi bằng db
          của app CHÍNH — lúc ghi, request.auth.uid là ADMIN chứ không phải
          người mới.

       2. `create` cũng phải chặn TỰ PHONG VAI, và ràng buộc `role` phải áp
          dụng cho CẢ hai vế — học sinh tự đăng ký lẫn giáo viên tạo hộ — chứ
          không chỉ vế học sinh. Đăng ký Firebase Auth bằng email + mật khẩu
          là công khai: ai cũng gọi thẳng API của Google để lấy một uid hợp lệ
          mà không cần đụng vào web, rồi ghi users/{uid} với role: "admin".
          Một giáo viên đang đăng nhập cũng lấy được uid mới kiểu đó rồi tự
          ghi role: "admin" nếu vế giáo viên không ép role — bỏ ngỏ vế nào thì
          cửa vẫn mở, chỉ là cửa khác.

       3. Học sinh KHÔNG tự đặt được `classId`/`schoolId`. Nếu cho, thì dù
          `classes` đã khoá, em vẫn tự xếp mình vào lớp bất kỳ qua cửa sau.
          Vào lớp đi bằng `pendingClassCode` rồi chờ giáo viên duyệt.

       4. `joinedClassId` là dấu hiệu thuộc lớp THỨ HAI — đọc như vậy ở
          `QuizProgressTab.tsx` và `DashboardPage.tsx`. Chặn `classId`/
          `schoolId` mà quên trường này thì cửa vẫn mở: học sinh tự đặt
          `joinedClassId` cho mình là chui được vào bảng tiến độ lớp của giáo
          viên, dù không hề có `classId` thật.

       5. So bằng `affectedKeys()` chứ KHÔNG so
          `request.resource.data.classId == resource.data.classId`: phần lớn hồ
          sơ không có hai trường đó, mà đọc một trường vắng mặt trong luật là
          lỗi, và lỗi thì từ chối — tức chặn nhầm mọi người.

       6. Vế chủ tài khoản của `update` cũng phải cấm tự sửa `username`/`email`.
          Sổ lớp (`classes.studentIdentifiers`) không khớp học sinh bằng
          `classId` mà bằng CHUỖI ĐỊNH DANH — so với `u.email` hoặc
          `u.username` (xem `ClassManagement.tsx`, `getTeacherName`/
          `handleExportCSV`). Mà `classes` cho MỌI người đã đăng nhập đọc, nên
          một em đọc được định danh trong sổ lớp đích rồi tự đặt `username`
          của mình thành đúng chuỗi ấy là hiện ra trong bảng tiến độ của giáo
          viên lớp đó — một cửa sau vào lớp không qua duyệt. Vế `laGiaoVien()`
          KHÔNG cấm hai trường này: giáo viên vẫn phải sửa được `username`/
          `email` hộ học sinh qua màn quản lý tài khoản. */
    match /users/{userId} {
      /* TÁCH `read` thành `get` và `list` — cố ý, 12/09/2026.
       *
       * Hai cách đọc `users` trong mã là HAI thao tác khác nhau:
       *   - `get`  : `getDoc(doc(db,'users',uid))` ở `firestoreAuth.ts:91` và
       *              trong hiệu ứng `onAuthStateChanged`. Đây là đường ĐĂNG
       *              NHẬP — học sinh phải đọc được hồ sơ của CHÍNH MÌNH.
       *   - `list` : `getDocs(collection(db,'users'))` ở
       *              `firestoreService.ts:83` (`getUsers()`), truy vấn KHÔNG
       *              ràng buộc, chỉ màn giáo viên/quản trị dùng. Đã đo: sáu tệp
       *              đọc mảng `users` đều là màn giáo viên/quản trị.
       *
       * Vì sao phải tách chứ không để một dòng `read`: với `list`, Firestore
       * đánh giá luật theo TỪNG tài liệu trả về, nên mệnh đề
       * `request.auth.uid == userId` phụ thuộc tài liệu và hành vi của cả truy
       * vấn thành khó đoán. Mà Rules Playground KHÔNG mô phỏng được `list`
       * (đã thử ngày 12/09/2026), nên không có cách nào đo trước khi publish.
       * Tách ra thì `list` chỉ còn MỘT mệnh đề không phụ thuộc tài liệu —
       * `laGiaoVien()` — và mệnh đề đó đã được đo bằng các phép thử ghi.
       *
       * Sai ở đây thì hỏng to theo hai hướng ngược nhau: `get` hỏng là KHÔNG
       * AI đăng nhập được; `list` hỏng là mọi màn giáo viên/quản trị trắng. */
      allow get:    if dangNhap() && (request.auth.uid == userId || laGiaoVien());
      allow list:   if laGiaoVien();

      allow create: if dangNhap() && (
                      laChuDuAn()
                      || (request.auth.uid == userId
                          && request.resource.data.role == 'student'
                          && !('classId' in request.resource.data)
                          && !('schoolId' in request.resource.data)
                          && !('joinedClassId' in request.resource.data))
                      || (laGiaoVien() && request.resource.data.role == 'student')
                      || (laDongQuanTri()
                          && request.resource.data.role in ['student', 'teacher', 'school_admin'])
                    );

      allow update: if dangNhap() && (
                      laChuDuAn()
                      || (request.auth.uid == userId
                          && !request.resource.data.diff(resource.data)
                               .affectedKeys().hasAny(['role', 'classId', 'schoolId', 'joinedClassId', 'username', 'email']))
                      || (laGiaoVien()
                          && !request.resource.data.diff(resource.data)
                               .affectedKeys().hasAny(['role']))
                      || (laDongQuanTri()
                          && request.resource.data.role in ['student', 'teacher', 'school_admin']
                          && resource.data.role != 'admin')
                    );

      allow delete: if laChuDuAn();
    }

    // ── Giới hạn chat: lượt thử của khách + khoá tạm khi spam (14/09/2026) ───
    /* Thay cho bộ đếm trong localStorage (xoá là hết giới hạn). Id tài liệu là
       uid: học sinh dùng uid tài khoản, khách dùng uid ĐĂNG NHẬP ẨN DANH trên
       app phụ. Chỉ lưu số và mã băm tin gần đây, không lưu chữ.
       Luật chặn ba đường gian lận phổ thông: đếm lùi lượt khách, tăng quá một
       lượt mỗi lần ghi (để "đốt" rồi xoá), và rút ngắn thời gian khoá.
       KHÔNG chặn được người xoá cả dữ liệu site để lấy uid ẩn danh mới — việc đó
       cần máy chủ. Xem giới hạn ở đầu gioiHanChatService.ts.
       Không dùng get(): đây là chỗ ghi mỗi lượt chat, không được tốn lượt đọc. */
    function gioiHanHopLe(d) {
      return d.keys().hasOnly(['luotKhach', 'thoiDiemGui', 'bamTinGanDay', 'luotPhatSpam', 'khoaDen'])
        && d.luotKhach is int && d.luotKhach >= 0 && d.luotKhach <= 25
        && d.thoiDiemGui is list && d.thoiDiemGui.size() <= 10
        && d.bamTinGanDay is list && d.bamTinGanDay.size() <= 3
        && d.luotPhatSpam is int && d.luotPhatSpam >= 0
        && d.khoaDen is int && d.khoaDen >= 0;
    }

    match /gioi_han_chat/{uid} {
      allow read: if dangNhap() && request.auth.uid == uid;
      allow create: if dangNhap() && request.auth.uid == uid
        && gioiHanHopLe(request.resource.data)
        && request.resource.data.luotKhach <= 1
        && request.resource.data.luotPhatSpam <= 1;
      allow update: if dangNhap() && request.auth.uid == uid
        && gioiHanHopLe(request.resource.data)
        && request.resource.data.luotKhach >= resource.data.luotKhach
        && request.resource.data.luotKhach <= resource.data.luotKhach + 1
        && request.resource.data.luotPhatSpam >= resource.data.luotPhatSpam
        && request.resource.data.khoaDen >= resource.data.khoaDen;
      allow delete: if false;
    }

    // ── Mọi thứ khác: cấm ───────────────────────────────────────────────────
    // Mười ba collection trên là toàn bộ những gì mã nguồn dùng tới, liệt kê
    // bằng cách quét `collection(db, …)` và các hằng `COL_*` ngày 10/09/2026.
    // Đã kiểm thêm: dự án KHÔNG dùng subcollection nào, nên các mục `match` một
    // tầng ở trên phủ hết. Thêm collection mới thì phải thêm luật cho nó ở đây.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
