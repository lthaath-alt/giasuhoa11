# ─── Header bảo mật, áp cho MỌI đường dẫn ───────────────────────────────────
#
# Cloudflare Pages đọc tệp này khi phát hành (cùng cú pháp Netlify, nơi web
# từng chạy tới 26/09/2026). Mục `/*` phải đứng ĐẦU và phủ mọi đường
# dẫn; các mục hẹp hơn bên dưới chỉ thêm header cache.
#
# Thêm ngày 10/09/2026, sau một lượt rà soát tìm ra lỗ hổng XSS lưu trữ:
# collection `bank_questions` để `allow write: if true` (ai cũng ghi được), và
# nội dung câu hỏi đọc từ đó đi thẳng vào `dangerouslySetInnerHTML`. Lỗ hổng đã
# được vá bằng bộ lọc `src/core/services/locHtml.ts`; những header dưới đây là
# HÀNG RÀO THỨ HAI, để lần sau ai đó quên gọi bộ lọc thì thiệt hại vẫn bị chặn.
#
# `npm run kiem-tra:an-ninh` canh cho những dòng này không biến mất.

/*
  # Trình duyệt đừng tự đoán kiểu tệp. Không có dòng này thì một tệp người dùng
  # tải lên bị đoán nhầm thành HTML là chạy được mã trong đó.
  X-Content-Type-Options: nosniff

  # Không cho site KHÁC nhúng trang này vào iframe rồi phủ lớp trong suốt lên
  # để lừa bấm — nguy nhất là ở màn đăng nhập.
  #
  # SAMEORIGIN chứ KHÔNG phải DENY. `DENY` cấm mọi trang nhúng, kể cả chính
  # trang này nhúng chính nó — và app có hai chỗ làm đúng như vậy: khung bài
  # giảng (`SlidesSection.tsx`) và khung trò chơi (`GameHubSection.tsx`), cả hai
  # đều trỏ tới đường dẫn cùng nguồn. Bản đầu để `DENY` và đã lên production
  # ngày 10/09/2026: toàn bộ bài giảng lẫn trò chơi hiện ra ô trống có biểu
  # tượng cấm. `frame-src 'self'` bên dưới KHÔNG cứu được — nó nói trang cha
  # được nhúng ai, còn dòng này nói trang con cho ai nhúng mình.
  #
  # Vì sao thử ở máy dev không bắt được: Vite KHÔNG đọc tệp `_headers` (đây là
  # tính năng của nền tảng phát hành), nên lượt thử hôm đó phải giả CSP bằng thẻ <meta> —
  # mà `X-Frame-Options` chỉ tồn tại ở dạng header, và `frame-ancestors` thì bị
  # bỏ qua khi đặt trong <meta>. Phép thử ấy về mặt cấu tạo không thể thấy lỗi
  # này. Muốn thử thật thì phải chạy `npx serve dist` hoặc deploy bản nháp.
  X-Frame-Options: SAMEORIGIN

  # Sang site ngoài (Zalo, Google) thì chỉ gửi tên miền, không gửi đường dẫn.
  # Đường dẫn ở đây có thể chứa mã đề kiểm tra.
  Referrer-Policy: strict-origin-when-cross-origin

  # App không dùng camera, micro, định vị hay cảm biến nào. Tắt sẵn thì mã lạ
  # chèn được vào cũng không xin quyền được.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

  # Chính sách nội dung — hàng rào thứ hai nếu bộ lọc HTML thủng.
  #
  #  script-src 'self'   Gói đã dựng KHÔNG có script nội tuyến nào (kiểm trong
  #                      dist/index.html), nên chặt được tới mức này. Đây là
  #                      dòng chặn `<img onerror=…>` và mọi mã chèn khác.
  #  style-src           MUI/emotion chèn thẻ <style> lúc chạy nên buộc phải có
  #                      'unsafe-inline'. Chấp nhận được: CSS nội tuyến không
  #                      chạy được mã, và script-src vẫn chặt.
  #  connect-src         Firestore, Gemini, và Google OAuth. Đây là dòng chặn
  #                      việc gửi trộm dữ liệu ra tên miền lạ.
  #  frame-src 'self'    Trò chơi chạy trong iframe CÙNG NGUỒN.
  #  object-src 'none'   Không dùng Flash/applet — đóng hẳn.
  #  base-uri 'self'     Chặn thẻ <base> bị chèn để đổi đích mọi đường dẫn.
  #  form-action 'self'  Biểu mẫu không được gửi đi đâu khác.
  #  frame-ancestors     Bản CSP của X-Frame-Options ở trên, cho trình duyệt mới.
  #                      Phải là 'self', không phải 'none' — xem lời giải thích
  #                      dài ở X-Frame-Options bên trên.
  #  script-src/frame-src thêm reCAPTCHA (13/09/2026): App Check của Firebase
  #                      AI Logic tải script và khung ẩn từ hai tên miền đó.
  #                      Thiếu thì gia sư báo "mất kết nối" trên web thật mà máy
  #                      dev vẫn chạy (Vite không đọc tệp này). Chỉ thêm ĐƯỜNG
  #                      DẪN /recaptcha/, không thêm cả tên miền google.com.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.googleapis.com https://*.google.com https://*.gstatic.com https://*.firebaseio.com wss://*.firebaseio.com; frame-src 'self' https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# ─── Cache cho ảnh bài giảng tĩnh (public/hoa11) ────────────────────────────
#
# Mặc định nền tảng đặt max-age=0, must-revalidate cho file tĩnh (Cloudflare
# Pages cũng vậy, đo 26/09/2026), nghĩa là mỗi
# lần học sinh mở lại một bài, trình duyệt phải hỏi server lại từng ảnh
# (~49 lượt hỏi cho một bài 12 slide). Bandwidth thì gần như bằng 0 vì server
# trả 304, nhưng độ trễ cộng dồn rất rõ trên mạng chậm.
#
# max-age=3600 -> trong 1 giờ dùng thẳng bản trong máy, không hỏi lại.
# stale-while-revalidate -> sau 1 giờ vẫn hiện ngay bản cũ rồi âm thầm tải bản mới.
#
# Hệ quả cần biết: sau khi bạn cập nhật bài giảng và deploy, học sinh đang mở
# sẵn có thể còn thấy ảnh cũ tối đa 1 giờ. Muốn hiện ngay lập tức thì giảm
# max-age xuống, ví dụ max-age=60.

/hoa11/slides/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/hoa11/mini/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/hoa11/thumbs/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
