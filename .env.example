# GEMINI_API_KEY: CHỈ cho script Node trong scripts/ (thu:ai, do-chi-phi).
# ĐỪNG BAO GIỜ đặt key Gemini vào biến có tiền tố VITE_: Vite chép nguyên văn
# vào gói JS. Web gọi Gemini qua Firebase AI Logic, không cần key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_APPCHECK_DEBUG_TOKEN: CHỈ đặt trong .env.development.local (máy dev).
# Token đăng ký ở Firebase Console → App Check → Manage debug tokens.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: Google OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=""

# FIREBASE CONFIGURATION — KHÔNG BẮT BUỘC.
# Sáu giá trị dưới đây đã có sẵn bản công khai trong
# src/core/services/firebaseCongKhai.ts, nên máy vừa clone về chạy được ngay mà
# không cần điền. Chỉ điền khi muốn trỏ sang một dự án Firebase KHÁC (thử
# nghiệm, lớp khác) — khi đó giá trị ở đây sẽ được ưu tiên.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""


# E2E_EMAIL / E2E_MATKHAU: tài khoản HỌC SINH dùng để chạy `npm run kiem-tra:e2e`.
# Dùng một tài khoản RIÊNG để thử, đừng dùng tài khoản của một em đang học: phép
# thử nối Firestore thật và có ghi tiến độ. Thiếu hai biến này thì phần cần đăng
# nhập tự BỎ QUA, phần khách vãng lai vẫn chạy.
E2E_EMAIL=""
E2E_MATKHAU=""

# E2E_URL: đích để thử. Bỏ trống là máy dev (http://localhost:3000).
# Muốn soi bản đã deploy thì đặt https://giasuhoa11.pages.dev
E2E_URL=""

# ── Tài khoản GIÁO VIÊN cho các script phải GHI Firestore ────────────────────
# Dùng bởi `npm run sua:cau-hoi -- <phiếu>.json --that`.
# Luật Firestore chỉ cho vai `teacher` trở lên ghi `bank_questions`.
#
# Cấp vai `teacher` THÔI, đừng cấp `admin`: ghi ngân hàng không cần tới nó, mà
# một tài khoản quản trị nằm trong tệp trên đĩa thì mở thêm cả `users` nếu máy
# bị lộ. Nên là một tài khoản lập riêng cho việc này, không phải tài khoản thầy
# cô đang dạy.
#
# Bỏ trống cũng được — script sẽ hỏi ngay tại máy, hiện dấu sao.
GIAO_VIEN_EMAIL=
GIAO_VIEN_MATKHAU=
